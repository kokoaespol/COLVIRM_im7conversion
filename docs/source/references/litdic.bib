@article{Bazant2022,
   abstract = {The recently conceived gap test and its simulation revealed that the fracture energy Gf of concrete, plastic-hardening metals, and composites can change by 100% depending on the crack-parallel stresses their history. Therefore, one must consider a fracture process zone with finite width and length, along with its tensorial damage behavior. The data from this test, along with ten other classical tests important for fracture problems (nine on concrete, one on sandstone), are optimally fitted to evaluate the performance of the phase-field, peridynamic and crack band models. Thanks to its realistic boundary and tensorial nature, the crack band model, combined with the microplane damage constitutive law in its latest version-M7, is found to fit all data well. On the contrary, the phase-field models perform poorly. Peridynamic models perform even worse, and the recent correction in the bond-associated deformation gradient helps improve the predictions in some experiments, but not all. This confirms the previous critique showing that peridynamics suffers from several conceptual faults: it implies a lattice microstructure; its particle-skipping interactions are fictitious; it ignores shear-resisted particle rotations; its representation of the boundaries, especially the crack and fracture process zone faces, is physically unrealistic; and it cannot reproduce the transitional size effect-a quintessential characteristic of quasibrittleness. The misleading practice of &#x93;verifying&#x94; a model with one or two simple tests matchable by many different models, or showcasing an ad hoc improvement for one type of test while ignoring misfits of others, is pointed out.},
   author = {Zdenek P. Bazant and Hoang Thai Nguyen and Ahmet Abdullah Dönmez},
   doi = {10.1115/1.4054221},
   issn = {0021-8936},
   journal = {Journal of Applied Mechanics},
   month = {3},
   pages = {1-79},
   title = {Critical Comparison of Phase-Field, Peridynamics and Crack Band Model M7 in Light of Gap Test and Classical Fracture Tests},
   url = {https://asmedigitalcollection.asme.org/appliedmechanics/article/doi/10.1115/1.4054221/1139865/Critical-Comparison-of-Phase-Field-Peridynamics},
   year = {2022}
}
@article{Freeman2020a,
   abstract = {A new specialised finite element for simulating the cracking and healing behaviour of quasi-brittle materials is presented. The element employs a strong discontinuity approach to represent displacement jumps associated with cracks. A particular feature of the work is the introduction of healing into the element formulation. The healing variables are introduced at the element level, which ensures consistency with the internal degrees freedom that represent the crack; namely, the crack opening, crack sliding and rotation. In the present work, the element is combined with a new cohesive zone model to simulate damage-healing behaviour and implemented with a crack tracking algorithm. To demonstrate the performance of the new element and constitutive models, a convergence test and two validation examples are presented that consider the response of a vascular self-healing cementitious material system for three different specimens. The examples show that the model is able to accurately capture the cracking and healing behaviour of this type of self-healing material system with good accuracy.},
   author = {Brubeck L. Freeman and Pedro Bonilla-Villalba and Iulia C. Mihai and Waled F. Alnaas and Anthony D. Jefferson},
   doi = {10.1186/s40323-020-00171-4},
   issn = {2213-7467},
   issue = {1},
   journal = {Advanced Modeling and Simulation in Engineering Sciences},
   month = {12},
   pages = {32},
   title = {A specialised finite element for simulating self-healing quasi-brittle materials},
   volume = {7},
   url = {https://amses-journal.springeropen.com/articles/10.1186/s40323-020-00171-4},
   year = {2020}
}
